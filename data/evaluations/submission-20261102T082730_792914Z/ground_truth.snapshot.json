  "annotation_policy": [
    "Every clip/event pair begins unreviewed. Suggested focus labels are proposals, not observations.",
    "No model predictions are shown or used to create ground truth. Inference is not started by this UI.",
    "Observed events need source-video time intervals; separate visits/bouts use separate intervals.",
    "Not observed is an explicit reviewed negative. Cannot tell is excluded from accuracy, never scored as a negative.",
    "Barking requires audible evidence. If the recording has no usable audio, mark it unassessable.",
    "These clips have been used during development. This is a small development benchmark, not a held-out test or a broad safety validation.",
    "Safety Watch is evaluated separately from custom-event routing; do not use the expected hazard label in the model prompt."
  ],
  "behaviors": {
    "drinking": "A pet drinks liquid, including sustained lapping from a container.",
    "eating": "A pet eats food, including taking food into its mouth and chewing.",
    "playing_with_mask": "A pet mouths, carries, paws at, or tugs a surgical face mask.",
    "furniture_chewing": "A pet bites, chews, or pulls furniture or its upholstery with its mouth.",
    "barking": "A dog barks repeatedly in an audible bout. Label bouts rather than each individual bark.",
    "standing_on_hind_legs": "A dog stands or balances upright on its hind legs, with both front paws off the ground.",
    "danger": "A visible dangerous interaction or circumstance threatens a pet, person, or the home, consistent with Safety Watch. Mere object presence, ordinary furniture chewing, and normal play are not automatically danger."
